# Oristoria - environment variable NAMES only. No values, ever.
# Fill your local .env (gitignored), never this file. See docs/ENV_GUIDE.md
# for where each value comes from. Names mirror docs/TECH_DESIGN.md section 8.

# --- Repo config (no dashboard needed) ---
# dev/prod switch for logging and guardrails - first task: add to .env.example
ENVIRONMENT=
# default chat model for the primary provider - first task: pick after the section 5 live checks
LLM_PRIMARY_PROVIDER=
# free/pro caps per metric (B3) - first task: define caps with the founder (PRD OQ-03)
PLAN_LIMITS_JSON=
# logging verbosity (dev default: debug, prod default: info) - first task: add default in config.py
LOG_LEVEL=
# gates real-service smoke tests (dev: on for manual runs, prod: off) - first task: wire into scripts/doctor.py
LIVE_CHECKS_ENABLED=

# --- Supabase (Dashboard -> Project Settings -> API) ---
# project URL, also derives the JWKS URL - first task: copy from dev project settings
SUPABASE_URL=
# publishable key for the browser auth client - first task: copy from dev project settings
SUPABASE_ANON_KEY=
# server-only admin key (Auth user deletion, nothing else) - first task: copy, then keep out of git and put in a secret store
SUPABASE_SERVICE_ROLE_KEY=
# runtime DSN as role app_api (session pooler) - first task: create app_api role via migration, copy DSN
DATABASE_URL=
# owner-role DSN for Alembic only - first task: copy direct DSN; keep out of the app image
MIGRATIONS_DATABASE_URL=
# allowed auth redirect (magic-link return) - first task: add http://localhost:5173/... then prod URL
AUTH_REDIRECT_URL=
# signs the session cookie (SSR helper); generate 32 random bytes - first task: generate 32-byte random value
AUTH_COOKIE_SECRET=
# JWT secret for verifying Supabase Auth tokens (Project Settings -> API -> JWT Secret) - first task: copy from dev project settings
SUPABASE_JWT_SECRET=

# --- Cloudflare R2 (Dashboard -> R2) ---
# cloudflare account for the S3 endpoint - first task: create account + bucket
R2_ACCOUNT_ID=
# bucket name (oristoria-dev / oristoria-prod) - first task: create the bucket
R2_BUCKET=
# scoped S3 access key (object read/write on one bucket) - first task: create scoped token
R2_ACCESS_KEY_ID=
# S3 secret for the key above (shown once) - first task: create with the key above
R2_SECRET_ACCESS_KEY=

# --- LLM providers ---
# primary LLM key - first task: create key, set a $0/free-model budget
OPENROUTER_API_KEY=
# default chat model id - first task: choose a free-tier model after the rate-limit check
OPENROUTER_MODEL=
# fallback LLM key - first task: create key
GROQ_API_KEY=
# groq model id - first task: pick model, note its RPM/TPM
GROQ_MODEL=
# second fallback key - first task: create key
NIM_API_KEY=
# nim model id - first task: pick model, note the ~40 RPM limit
NIM_MODEL=
# optional tracing (OQ-06) - LEAVE UNSET until OQ-06 is decided; first task: none
LANGSMITH_API_KEY=

# --- Resend (transactional email, non-auth) ---
# email API key - first task: create key + verify sending domain
RESEND_API_KEY=
# from-address on the verified domain - first task: verify domain, set address
EMAIL_FROM=

# --- Google Cloud (Cloud Run + Cloud Tasks) ---
# gcp project for Cloud Run + Tasks - first task: create GCP project, enable billing card for free-tier use only (LIVE CHECK)
GOOGLE_CLOUD_PROJECT=
# queue name (ingest-dev / ingest-prod) - first task: create queue in the chosen region
CLOUD_TASKS_QUEUE=
# path to service-account JSON (local/CI only) - first task: create SA with Cloud Tasks Enqueuer only
GOOGLE_APPLICATION_CREDENTIALS=
# deploy region for the API service - first task: pick region near ap-northeast-1 (LIVE CHECK eligible free regions)
CLOUD_RUN_REGION=

# --- Frontend ---
# CORS allow-list origin (dev: http://localhost:5173) - first task: create Pages project first
FRONTEND_ORIGIN=
# founder-only admin endpoints (entitlement grant); generate, never commit - first task: generate and store in a password manager / Secret Manager
ADMIN_API_KEY=
